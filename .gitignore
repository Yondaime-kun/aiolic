# The built binary shares the module name, so it is anchored: an unanchored
# "aiolic" would also ignore the cmd/aiolic/ source directory.
/aiolic

# Keys generated by `serve -key-out` are this server's own keys and are never
# committed; the ones in the demo are ephemeral.
keys.json
*.pem
*.key

# Editors and OS noise.
*~
.DS_Store
.idea/
.vscode/
